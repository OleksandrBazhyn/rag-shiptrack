# Ключ OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Моделі (за потреби можна замінити)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Кількість фрагментів контексту
RAG_TOP_K=4

# Ціни за 1 млн токенів, USD (лише для оцінки витрат у консолі)
PRICE_INPUT_PER_1M=0.15
PRICE_OUTPUT_PER_1M=0.60
PRICE_EMBED_PER_1M=0.02
